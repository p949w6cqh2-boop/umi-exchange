# Production Caddyfile — reciprocalaid.network (live).
# This reflects the deployed configuration (see docs/deploy/vps-runbook.md §5):
#   - domain hardcoded (apex + www); certs auto-provisioned by Let's Encrypt
#   - NO /static/* file_server: static is served by the app's WhiteNoise, and
#     /srv/static is not mounted into the Caddy container (an old /static block
#     404'd every asset)
#   - logs go to stdout (docker logs), NOT /var/log/caddy (that path is unmounted
#     and Caddy errors trying to write it)
#   - header_up X-Real-IP {remote_host}: load-bearing for Django's audit-log IP
#     hashing + rate limiting; safe only while Caddy is the edge proxy.
reciprocalaid.network, www.reciprocalaid.network {
    encode gzip zstd

    log {
        output stdout
        format console
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }

    reverse_proxy app:8000 {
        header_up X-Real-IP {remote_host}
    }
}
