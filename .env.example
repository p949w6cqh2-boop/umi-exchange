# UMI Exchange — Environment Variables
# Copy this file: cp .env.example .env
# Then edit .env with your values.

# ── Required ──────────────────────────────────────────
# Generate: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-50-char-string
# PostgreSQL: postgres://user:pass@host:5432/dbname | SQLite: sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (docker-compose.prod.yml): runtime role ≠ migration owner, so the
# append-only audit REVOKE binds (deployment-checklist.md "Database roles").
# APP_DB_USER=umi_app
# APP_DB_PASSWORD=strong-password-for-umi_app
# AUDIT_DB_APP_ROLE=umi_app

# ── Optional: Infrastructure ──────────────────────────
REDIS_URL=redis://localhost:6379/0
SITE_URL=http://localhost:8000
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# §12.3 name blind index: a DEDICATED secret, never the same value as the
# encryption keys. Person name writes fail closed while this is unset.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BLIND_INDEX_KEY=
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Email ─────────────────────────────────────────────
# Dev: console (prints to terminal). Production: smtp
# Email: dev prints to the console. In PRODUCTION, fill EMAIL_HOST_USER +
# EMAIL_HOST_PASSWORD and production settings auto-switch to SMTP delivery
# (you can also force it by setting EMAIL_BACKEND explicitly). Notification
# email is consented per user (they can opt out in account settings).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=UMI Exchange <noreply@yourdomain.org>
# SMTP — your parish/diocese mail server, or a transactional provider.
# PORT: 587 is the standard STARTTLS port and it does NOT work on DigitalOcean.
# DO blocks outbound 25/465/587 by default as an anti-spam measure, and the
# failure is a connect TIMEOUT, not an auth error — it looks like a hung network.
# Resend publishes 2587 (STARTTLS, pairs with EMAIL_USE_TLS=True) and 2465
# (implicit TLS, needs EMAIL_USE_SSL=True instead) for exactly this case.
# Measured on the droplet 2026-09-11: 25/465/587 BLOCKED, 2465/2587 OPEN.
EMAIL_HOST=smtp.yourdomain.org
EMAIL_PORT=2587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Optional: Monitoring ──────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
HEALTH_CHECK_TOKEN=

# ── Optional: Deployment ──────────────────────────────
GIT_SHA=
DB_PASSWORD=change-me-in-production

# ── Optional: Docker Compose ─────────────────────────
POSTGRES_USER=umi
POSTGRES_PASSWORD=umi
POSTGRES_DB=umi_exchange
REDIS_PASSWORD=

# ── Optional: Backups ─────────────────────────────────
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Set to 1 once B2 is provisioned (recommended in production): backup.sh then
# exits nonzero any night the off-site copy cannot be made, instead of quietly
# keeping a local-only backup.
BACKUP_REQUIRE_REMOTE=
# Heartbeat URL (UptimeRobot heartbeat monitor, healthchecks.io, or similar).
# backup.sh pings it ONLY on a fully successful run, and the monitor alerts when
# the ping does NOT arrive in its window. Exiting nonzero is not an alert — cron
# mails root and root mail on the droplet goes nowhere — and an inverted signal
# also catches the backup that never ran at all (dead cron, full disk, dead host).
# Set the monitor's window LONGER than one backup cycle. https only: the URL is a
# bearer token, and anyone holding it can forge "all clear".
BACKUP_HEARTBEAT_URL=

# ── UMI Protocol ──────────────────────────────────────
UMI_CONFORMANCE_LEVEL=core
